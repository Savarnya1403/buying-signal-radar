# ---------------------------------------------------------------------------
# Buying Signal Radar — environment variables
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string.
# Local Prisma Postgres (npx prisma dev) example:
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true
# Add `pgbouncer=true` when your provider pools connections, and `sslmode=require`
# for hosted databases that enforce TLS.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true"

# Optional. Public base URL used for shareable report links and metadata.
# Vercel sets VERCEL_URL automatically, so this is only needed for custom domains.
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Optional. Web-search connector. Without either key the app still runs: RSS,
# public job feeds, company websites and user-supplied URLs all work, and the
# discover wizard marks web search as unavailable instead of faking results.
# TAVILY_API_KEY="tvly-..."
# BRAVE_SEARCH_API_KEY="..."
